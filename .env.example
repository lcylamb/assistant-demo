# 复制成 .env 后按需修改。.env 已在 .gitignore 里，不会进仓库。
#
#   cp .env.example .env

# ---- 数据库 ----
# 端口是 5433，对应 docker-compose.yml 里的 db 服务。
# 生产环境这个值由部署平台注入，不要写死在代码里。
DATABASE_URL="postgresql://demo:demo@localhost:5433/assistant_demo?schema=public"

# ---- 服务 ----
PORT=3100

# 流式的心跳间隔（毫秒）。默认 15000，设 0 关闭。
#
# 工具轮里会有几秒钟一个字节都不发的空档，代理（nginx 默认 60s、Cloudflare 100s）
# 会把空闲连接当成死连接掐掉。服务端在空闲超过这个值后写一个 SSE 注释帧 `: ping`，
# 客户端按规范忽略它，代理的计时器因此重置。
# 只在本地想看干净原始流时关掉；部署环境别关。
# SSE_HEARTBEAT_MS=15000

# 一次提问的总预算（毫秒），含所有工具轮。默认 90000，0 = 关。
# 和 LLM_TIMEOUT_MS 是两回事：那个管「这一轮最多等多久」，这个管「整次提问最多跑多久」。
# 没有它的话，4 轮 × 30 秒的上限只是**每轮**的，合起来是两分钟。
# 到点之后：非流式返回 504；流式响应头早就发出去了，只能发一条 error 帧。
# ASK_TIMEOUT_MS=90000

# 限流：每个 IP 每分钟允许多少次请求。默认 30（见 src/app.module.ts）。
# 演示用值是宽松的：真人点着玩碰不到，脚本刷立刻撞墙。
# RATE_LIMIT_PER_MINUTE=30

# 并发上限：同一时刻最多允许多少个模型请求活着。默认 8，0 = 关。
# 和上面那个不是一回事：限流管「一分钟进来多少」，这个管「同时有多少在跑」。
# 30 次/分 × 单次最长 90 秒，最坏会堆到几十个并发 —— 频率合规、额度没用完，
# 但进程内存和上游连接先撑不住。超出的请求拿到 429（不进业务、不调模型）。
# ⚠️ 计数在进程内存里：多实例部署时实际上限是配置值的 N 倍。
# MAX_CONCURRENT_ASKS=8

# 反向代理：只在**确实**部署在代理后面时才设，值是信任的跳数（托管平台通常是 1）。
#
# 这两个方向都会出错，所以不能靠猜、也不给默认值：
#   · 该设没设 → 所有人的请求算成同一个 IP，一个人刷满，其他人全 429。
#   · 不该设设了 → 谁都能用 `X-Forwarded-For` 换个身份，限流形同虚设。
# 本地直连（含 docker compose）就保持注释状态。
# 详见 src/app-setup.ts。
# TRUST_PROXY=1

# ---- LLM ----
# mock   = 规则表。不需要密钥，测试和本地开发用这个（默认）。
# openai = 真模型。任何说 OpenAI /chat/completions 协议的服务都行 ——
#          DeepSeek、通义、Kimi、甚至本地跑的 vLLM，区别只在下面三行怎么填。
LLM_PROVIDER=mock

# ⚠️ 只放本地 .env 和部署平台的 secret，永远不进仓库。
# ⚠️ 部署到公网前必须另配一个专用 key —— 公开端点会被人刷额度。
#
# 用 openai 时这三行必填：缺任意一个，**服务会直接起不来**（这是有意的，
# 见 src/modules/llm/llm.module.ts —— 「以为接了真模型、其实在跑假数据」最坏）。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 单次调用的超时（毫秒）。非流式是整个请求的上限。
# 流式里它管两件事：等**第一个字**，以及相邻两帧之间最多沉默多久 ——
# 不限制整条流的总时长（答得慢不该被腰斩，彻底沉默才该）。
# LLM_TIMEOUT_MS=30000

# 输出上限。答案是一句 JSON，这个值给的是「被刷时的爆炸半径」。
# LLM_MAX_TOKENS=1024

# 厂商临时失败时最多试几次（**含第一次**），默认 3。1 = 关掉重试。
# 只重试「等会儿可能就好」的失败：连不上、429、5xx。
# 鉴权 / 余额 / 参数错误不重试（再试一百次也一样）；
# 已经等满 LLM_TIMEOUT_MS 的超时也不重试（只会让用户多等一轮）。
# 流式只在**第一个字之前**重试 —— 开始吐字之后再试会把同一段话吐两遍。
# 厂商给的 Retry-After 超过 2 秒时直接失败，不硬等。
# LLM_MAX_ATTEMPTS=3

# 强制厂商输出合法 JSON（response_format）。少数服务不支持，用这个关掉。
# 注意这是**收窄**不是**保证** —— 合法 JSON 照样可以是错的答案，
# 所以 parseAnswer 那道校验不会因此撤掉。
# LLM_JSON_MODE=true

# 流式请求里额外要一帧用量（OpenAI 协议的 stream_options.include_usage）。
# 默认开：不打开的话流式端点永远拿不到 token 数，而流式是页面真正在用的那条路。
# 少数兼容实现不认这个字段、会直接 400，那时用 false 关掉。
# LLM_STREAM_USAGE=true

# 成本单价：**每百万 token** 的价格。只影响 GET /assistant/metrics 里的 cost 字段。
# 两个必须一起配，只配一个会在启动时失败（缺的那一半不会被当成 0）。
# ⚠️ 下面是示例值，随厂商和缓存命中率变化 —— 用之前先去价目表核对。
# ⚠️ 这里**不**计算缓存价（命中缓存的 prompt 通常更便宜），只按普通 prompt 计价。
# LLM_PRICE_INPUT_PER_M=2
# LLM_PRICE_OUTPUT_PER_M=8
# LLM_PRICE_CURRENCY=CNY

# 每天允许多少次模型调用（**按进程内存计**，UTC 日界）。0 或不填 = 关闭。
# 和 RATE_LIMIT_PER_MINUTE 是互补的两层：那个防「一个脚本猛刷」，
# 这个防「一万个 IP 各刷三次」—— 后者挡不住的话烧的是额度，不是服务。
# 只在部署实例上设，本地和 e2e 会把它刷满。
# ⚠️ 计数在进程内存里：多实例部署时实际额度是配置值的 N 倍，重启会清零。
# LLM_DAILY_LIMIT=300

# 调试用：让假模型故意引用一个不存在的字段，用来验证防幻觉那道校验真的会拦东西。
#   MOCK_MISBEHAVE=unknown-field
# MOCK_MISBEHAVE=

# 调试用：假模型流式输出时每块之间停多久（毫秒，默认 25）。
# 调大就有了一条**足够长的流**，用来演示首字延迟，或者复现
# 「活跃的 SSE 流会不会拖住优雅退出」——CI 里就是这么测的。
# MOCK_CHUNK_DELAY_MS=1000
# ---- 知识库问答（knowledge 模块）----
# DeepSeek 走 OpenAI 兼容协议；embedding 是本地模型（.models 目录，自动下载），不需要单独的 key
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# HuggingFace 直连超时时的镜像站
HF_MIRROR=https://hf-mirror.com
